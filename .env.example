# Front end (Vercel project settings → Environment Variables, or .env.local for `npm run dev`)
# Both values are public by design; data is protected by Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Tenant shown on *.vercel.app preview links and localhost (custom domains resolve automatically)
VITE_DEFAULT_TENANT=aryas

# Edge function secrets: set with `supabase secrets set NAME=value`. NEVER put these in Vercel or the repo.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...            (endpoint for "Your account" events)
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...    (endpoint for "Connected accounts" events, once Connect is on)
# APP_URL=https://cloud-kitchen.vercel.app   (used in emails and as the Stripe redirect fallback)
# ALLOWED_ORIGINS=https://cloud-kitchen.vercel.app,https://order.aryascuisine.com,http://localhost:5173
# RESEND_API_KEY=re_...                      (optional; emails are skipped and logged without it)
# EMAIL_FROM=Aryas Cuisine <orders@aryascuisine.com>
